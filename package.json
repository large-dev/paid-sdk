{
  "name": "@paid/sdk",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "Drop-in crypto payment drawer for any React app. Powered by PAID.",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "viem": ">=2.0.0",
    "@wagmi/core": ">=2.0.0",
    "framer-motion": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "viem": "^2.23.0",
    "@wagmi/core": "^2.16.0",
    "framer-motion": "^11.0.0",
    "vitest": "^3.0.0"
  }
}
